  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(2px);
}

.dev-modal-box {
  position: relative;
  z-index: 10001;
  background: #0f172a;
  border: 1px solid #3b82f6;
  border-radius: 8px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.8);
  width: calc(100% - 40px);
  max-width: 650px;
