  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid #94a3b8;
}

.badge-pill.yellow { background: var(--pill-yellow-bg); color: var(--pill-yellow-txt); }
.badge-pill.blue { background: var(--pill-blue-bg); color: var(--pill-blue-txt); }
.badge-pill.green { background: var(--pill-green-bg); color: var(--pill-green-txt); }
.badge-pill.red { background: var(--pill-red-bg); color: var(--pill-red-txt); }

.session-metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
}

.metric-box {
  border: var(--border-dark);
  border-radius: 6px;
  padding: 10px;
  background: #0f172a;
  display: flex;
  flex-direction: column;
}

.metric-box strong {
  font-size: 16px;
}

.metric-box span {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
}

/* Stats Cards Grid */
.stats-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}

.stats-cards-grid.master {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.metric-card {
  border: var(--border-dark);
  border-radius: 8px;
  padding: 16px;
  box-shadow: 3px 3px 0 #000000;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metric-card span {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.metric-card strong {
  font-size: 28px;
  line-height: 1;
}

.metric-card small {
  font-size: 11px;
  color: var(--text-muted);
}

.metric-card.yellow { background: var(--pill-yellow-bg); }
.metric-card.blue { background: var(--pill-blue-bg); }
.metric-card.green { background: var(--pill-green-bg); }
.metric-card.red { background: var(--pill-red-bg); }
.metric-card.gray { background: var(--pill-gray-bg); }

/* Master Jobs Table */
.data-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
  font-size: 13px;
}

.data-table th, .data-table td {
  border: var(--border-light);
  padding: 8px 12px;
  text-align: left;
}

.data-table th {
  background: #334155;
  font-weight: 700;
}

.data-table tr:nth-child(even) {
  background: #0f172a;
}

/* Buttons */
.button {
  border: var(--border-dark);
  border-radius: 6px;
  background: var(--accent-orange);
  color: #f8fafc;
  cursor: pointer;
  padding: 8px 16px;
  font-weight: 700;
  font-size: 13px;
  box-shadow: 2px 2px 0 #000000;
}

.button:hover { background: #c2410c; }
.button.secondary { background: var(--panel-white); color: var(--text-main); }
.button.small { padding: 4px 10px; font-size: 12px; }

.login-panel {
  max-width: 440px;
  margin: 40px auto;
  background: var(--panel-white);
  border: var(--border-dark);
  border-radius: 8px;
  box-shadow: var(--shadow-offset);
  padding: 24px;
}

.login-panel form { display: grid; gap: 16px; }
.button-group { display: flex; gap: 10px; flex-wrap: wrap; }
.link-button { background: none; border: none; padding: 0; color: var(--accent-orange); font-size: 13px; cursor: pointer; text-decoration: underline; }
.info-message { color: var(--pill-green-txt); background: var(--pill-green-bg); border: 1px solid #10b981; padding: 10px; border-radius: 6px; }
.error { color: var(--pill-red-txt); font-size: 13px; margin: 0; }

.margin-top { margin-top: 16px; }
.table-responsive { overflow-x: auto; }

/* Navigation Action Buttons (Copy Link & Show QR) */
.nav-action-btn {
  border: var(--border-dark);
  background: var(--panel-white);
  padding: 6px 14px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  border-radius: 4px;
  color: var(--text-main);
  box-shadow: 1px 1px 0 #000000;
  transition: all 0.15s ease;
}

.nav-action-btn:hover {
  background: #422006;
}

/* Modal Overlay Styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(2px);
}

.modal-box {
  position: relative;
  z-index: 10000;
  background: var(--panel-white);
  border: var(--border-dark);
  border-radius: 12px;
  box-shadow: 6px 6px 0 #000000;
  padding: 20px;
  max-width: 380px;
  width: calc(100% - 32px);
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: modalPop 0.15s ease-out;
}

@keyframes modalPop {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid #334155;
  padding-bottom: 10px;
}

.modal-header h3 {
